spawn-sh-at-startup "systemctl --user import-environment DISPLAY WAYLAND_DISPLAY XDG_SESSION_TYPE XDG_SESSION_DESKTOP XDG_CURRENT_DESKTOP"
spawn-sh-at-startup "waybar"
spawn-at-startup "dunst"
spawn-sh-at-startup "wl-paste --type text --watch cliphist store"
spawn-sh-at-startup "wl-paste --type image --watch cliphist store"
spawn-at-startup "/usr/lib/polkit-kde-authentication-agent-1" // 认证程序
spawn-at-startup "awww-daemon"
// spawn-sh-at-startup "awww img ~/Pictures/wallpaper/线条小狗.jpg"
spawn-sh-at-startup "fcitx5 -d"
spawn-at-startup "udiskie"
spawn-sh-at-startup "mbsync -a"
spawn-sh-at-startup "swaybg -i ~/Pictures/wallpaper/21:9/universe.jpg"
spawn-sh-at-startup "niri msg action focus-workspace 3"
spawn-sh-at-startup "~/.config/niri/scripts/niri_resetxdgportal.sh"
spawn-sh-at-startup "~/.config/niri/scripts/microphone/receiver.py"
